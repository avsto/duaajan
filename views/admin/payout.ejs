<!DOCTYPE html>

<html lang="en">

<head>


<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
    Payout - DuaAjan Admin
</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<style>

    body {
        margin: 0;
        background: #0f172a;
        color: #fff;
        font-family: Arial, sans-serif;
    }

    .topbar {
        background: #111827;
        padding: 20px 30px;
        border-bottom: 1px solid rgba(255, 255, 255, .08);
    }

    .brand {
        font-size: 24px;
        font-weight: 700;
    }

    .page-card {
        background: #111827;
        border-radius: 24px;
        padding: 25px;
        margin-top: 25px;
        border: 1px solid rgba(255, 255, 255, .05);
    }

    .table {
        color: #fff;
        margin-bottom: 0;
    }

    .table thead {
        background: #1e293b;
    }

    .table th {
        border: none;
        color: #cbd5e1;
        padding: 16px;
        white-space: nowrap;
    }

    .table td {
        border-color: rgba(255, 255, 255, .05);
        padding: 16px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: rgba(255, 255, 255, .025);
    }

    .stats-card {
        background: #111827;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, .05);
        height: 100%;
    }

    .stats-card h2 {
        margin: 0;
        font-weight: bold;
    }

    .pagination .page-link {
        background: #1e293b;
        border-color: #334155;
        color: #fff;
    }

    .pagination .active .page-link {
        background: #3b82f6;
        border-color: #3b82f6;
    }

    .pagination .page-link:hover {
        background: #334155;
        color: #fff;
    }

    .badge-success-custom {
        background: #10b981;
    }

    .badge-pending {
        background: #f59e0b;
    }

    .badge-danger-custom {
        background: #ef4444;
    }

    .badge-primary-custom {
        background: #3b82f6;
    }

    .badge-secondary-custom {
        background: #64748b;
    }

    .empty-box {
        padding: 60px;
        text-align: center;
    }

    .empty-box i {
        font-size: 60px;
        color: #64748b;
        margin-bottom: 15px;
    }

    .masjid-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .masjid-info h3 {
        margin-bottom: 5px;
    }

    .text-secondary-custom {
        color: #94a3b8;
    }

    .wallet-box {
        background: #1e293b;
        border-radius: 18px;
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, .05);
    }

    .wallet-label {
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 7px;
    }

    .wallet-amount {
        font-size: 30px;
        font-weight: 700;
    }

    .setting-box {
        background: #1e293b;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid rgba(255, 255, 255, .05);
    }

    .setting-label {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .setting-value {
        font-size: 19px;
        font-weight: 700;
    }

    .modal-content {
        background: #111827;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 20px;
    }

    .modal-header,
    .modal-footer {
        border-color: rgba(255, 255, 255, .08);
    }

    .modal-header .btn-close {
        filter: invert(1);
    }

    .form-label {
        color: #cbd5e1;
    }

    .form-control,
    .form-select {
        background: #1e293b;
        color: #fff;
        border-color: #334155;
        min-height: 45px;
    }

    .form-control:focus,
    .form-select:focus {
        background: #1e293b;
        color: #fff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 .2rem rgba(59, 130, 246, .15);
    }

    .form-control::placeholder {
        color: #64748b;
    }

    .input-group-text {
        background: #334155;
        color: #fff;
        border-color: #334155;
    }

    .info-box {
        background: rgba(59, 130, 246, .08);
        border: 1px solid rgba(59, 130, 246, .2);
        border-radius: 14px;
        padding: 15px;
        color: #cbd5e1;
    }

    .warning-box {
        background: rgba(245, 158, 11, .08);
        border: 1px solid rgba(245, 158, 11, .2);
        border-radius: 14px;
        padding: 15px;
        color: #cbd5e1;
    }

    @media(max-width: 768px) {

        .topbar {
            padding: 18px 15px;
        }

        .brand {
            font-size: 20px;
        }

        .container {
            padding-left: 12px;
            padding-right: 12px;
        }

        .page-card {
            padding: 18px;
            border-radius: 18px;
        }

        .masjid-info {
            align-items: flex-start;
            flex-direction: column;
        }

        .masjid-info .text-end {
            text-align: left !important;
        }

        .table th,
        .table td {
            padding: 13px;
        }

    }

</style>


</head>

<body>

<!-- =====================================================
     TOPBAR
===================================================== -->

<div class="topbar">


<div class="d-flex justify-content-between align-items-center">

    <div class="brand">

        <i class="fa-solid fa-money-bill-transfer me-2"></i>

        Payout

    </div>


    <a
        href="/admin/masjids"
        class="btn btn-light"
    >

        <i class="fa-solid fa-arrow-left me-1"></i>

        Back To Masjids

    </a>

</div>


</div>

<div class="container py-4">

<!-- =====================================================
     MASJID INFO
===================================================== -->

<div class="page-card">


<div class="masjid-info">

    <div>

        <h3>

            <i class="fa-solid fa-mosque me-2"></i>

            <%= masjid.masjidName %>

        </h3>

        <div class="text-secondary-custom">

            <%= masjid.address || "No Address Available" %>

        </div>

        <% if (masjid.pincode) { %>

            <small class="text-secondary-custom">

                PIN: <%= masjid.pincode %>

            </small>

        <% } %>

    </div>


    <div class="text-end">

        <h2 class="text-success">

            ₹<%= Number(masjid.wallet || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>

        </h2>

        <small class="text-secondary-custom">

            Current Wallet

        </small>

    </div>

</div>


</div>

<!-- =====================================================
     STATS
===================================================== -->

<div class="row g-3 mt-1">


<div class="col-md-3">

    <div class="stats-card">

        <h2 class="text-success">

            ₹<%= Number(masjid.wallet || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>

        </h2>

        <div class="text-secondary-custom">

            Wallet Balance

        </div>

    </div>

</div>


<div class="col-md-3">

    <div class="stats-card">

        <h2 class="text-info">

            ₹<%= Number(totalDonation || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>

        </h2>

        <div class="text-secondary-custom">

            Total Donations

        </div>

    </div>

</div>


<div class="col-md-3">

    <div class="stats-card">

        <h2 class="text-warning">

            ₹<%= Number(totalPayout || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>

        </h2>

        <div class="text-secondary-custom">

            Total Payout

        </div>

    </div>

</div>


<div class="col-md-3">

    <div class="stats-card">

        <h2 class="text-primary">

            <%= Number(totalPayoutTransactions || 0) %>

        </h2>

        <div class="text-secondary-custom">

            Payout Transactions

        </div>

    </div>

</div>


</div>

<!-- =====================================================
     PAYOUT SETTING
===================================================== -->

<div class="page-card">


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h4 class="mb-1">

            <i class="fa-solid fa-sliders me-2"></i>

            Payout Setting

        </h4>

        <div class="text-secondary-custom">

            Current payout configuration

        </div>

    </div>


    <button
        type="button"
        class="btn btn-outline-light"
        data-bs-toggle="modal"
        data-bs-target="#payoutSettingsModal"
    >

        <i class="fa-solid fa-pen-to-square me-1"></i>

        Edit

    </button>

</div>


<div class="row g-3">


    <div class="col-md-6">

        <div class="setting-box">

            <div class="setting-label">

                Payout Type

            </div>

            <div class="setting-value">

                <% if (masjid.walletAccepted === "percentage") { %>

                    <span class="badge badge-primary-custom">

                        Percentage

                    </span>

                <% } else { %>

                    <span class="badge badge-secondary-custom">

                        Fixed Amount

                    </span>

                <% } %>

            </div>

        </div>

    </div>


    <div class="col-md-6">

        <div class="setting-box">

            <div class="setting-label">

                Accepted Amount

            </div>

            <div class="setting-value text-success">

                <% if (masjid.walletAccepted === "percentage") { %>

                    <%= Number(masjid.walletAcceptedAmount || 0).toLocaleString("en-IN", {
                        maximumFractionDigits: 2
                    }) %>%

                <% } else { %>

                    ₹<%= Number(masjid.walletAcceptedAmount || 0).toLocaleString("en-IN", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) %>

                <% } %>

            </div>

        </div>

    </div>


</div>


</div>

<!-- =====================================================
     PAYOUT HISTORY
===================================================== -->

<div class="page-card">


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h4 class="mb-1">

            <i class="fa-solid fa-clock-rotate-left me-2"></i>

            Payout History

        </h4>

        <div class="text-secondary-custom">

            Successfully processed payout records

        </div>

    </div>


    <button
        type="button"
        class="btn btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#payoutModal"
    >

        <i class="fa-solid fa-plus me-1"></i>

        New Payout

    </button>

</div>


<div class="table-responsive">

    <table class="table">

        <thead>

            <tr>

                <th>#</th>

                <th>Date</th>

                <th>Amount</th>

                <th>Status</th>

                <th>Processed By</th>

                <th>Note</th>

            </tr>

        </thead>


        <tbody>


        <% if (payoutTransactions && payoutTransactions.length > 0) { %>


            <% payoutTransactions.forEach((item, index) => { %>

                <tr>


                    <td>

                        <%= ((currentPage - 1) * 20) + index + 1 %>

                    </td>


                    <td>

                        <% if (item.createdAt) { %>

                            <%= new Date(item.createdAt).toLocaleString("en-IN") %>

                        <% } else { %>

                            -

                        <% } %>

                    </td>


                    <td>

                        <strong class="text-success">

                            ₹<%= Number(
                                item.payoutAmount || item.amount || 0
                            ).toLocaleString("en-IN", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %>

                        </strong>

                    </td>


                    <td>

                        <% if (
                            item.payoutStatus === "success" ||
                            item.status === "success"
                        ) { %>

                            <span class="badge badge-success-custom">

                                <i class="fa-solid fa-circle-check me-1"></i>

                                SUCCESS

                            </span>

                        <% } else if (
                            item.payoutStatus === "pending" ||
                            item.status === "pending"
                        ) { %>

                            <span class="badge badge-pending">

                                <i class="fa-solid fa-clock me-1"></i>

                                PENDING

                            </span>

                        <% } else { %>

                            <span class="badge badge-danger-custom">

                                <%= item.payoutStatus || item.status || "FAILED" %>

                            </span>

                        <% } %>

                    </td>


                    <td>

                        <% if (item.payoutProcessedBy) { %>

                            <strong>

                                <%= item.payoutProcessedBy.name || "Admin" %>

                            </strong>

                            <% if (item.payoutProcessedBy.mobile) { %>

                                <br>

                                <small class="text-secondary-custom">

                                    <%= item.payoutProcessedBy.mobile %>

                                </small>

                            <% } %>


                        <% } else if (item.processedBy) { %>

                            <strong>

                                <%= item.processedBy.name || "Admin" %>

                            </strong>

                            <% if (item.processedBy.mobile) { %>

                                <br>

                                <small class="text-secondary-custom">

                                    <%= item.processedBy.mobile %>

                                </small>

                            <% } %>


                        <% } else { %>

                            -

                        <% } %>

                    </td>


                    <td>

                        <span class="text-secondary-custom">

                            <%= item.payoutNote || item.note || "-" %>

                        </span>

                    </td>


                </tr>

            <% }) %>


        <% } else { %>


            <tr>

                <td colspan="6">

                    <div class="empty-box">

                        <i class="fa-solid fa-money-bill-transfer"></i>

                        <h4>

                            No Payout History Found

                        </h4>

                        <div class="text-secondary-custom">

                            No successful payout has been processed yet.

                        </div>

                    </div>

                </td>

            </tr>


        <% } %>


        </tbody>

    </table>

</div>


</div>

<!-- =====================================================
     DONATION HISTORY
===================================================== -->

<div class="page-card">


<div class="mb-4">

    <h4 class="mb-1">

        <i class="fa-solid fa-hand-holding-heart me-2"></i>

        Donation History

    </h4>

    <div class="text-secondary-custom">

        Successful donations received by this masjid

    </div>

</div>


<div class="table-responsive">

    <table class="table">

        <thead>

            <tr>

                <th>#</th>

                <th>Date</th>

                <th>Donor</th>

                <th>Payment ID</th>

                <th>Donation</th>

                <th>Paid Out</th>

                <th>Remaining</th>

                <th>Status</th>

            </tr>

        </thead>


        <tbody>


        <% if (payoutHistory && payoutHistory.length > 0) { %>


            <% payoutHistory.forEach((item, index) => { %>


                <%
                    const donationAmount =
                        Number(item.amount || 0);

                    const paidAmount =
                        Number(item.payoutAmount || 0);

                    const remainingAmount =
                        Math.max(
                            0,
                            donationAmount - paidAmount
                        );
                %>


                <tr>


                    <td>

                        <%= ((currentPage - 1) * 20) + index + 1 %>

                    </td>


                    <td>

                        <% if (item.createdAt) { %>

                            <%= new Date(item.createdAt).toLocaleString("en-IN") %>

                        <% } else { %>

                            -

                        <% } %>

                    </td>


                    <td>


                        <% if (item.anonymous) { %>

                            <span class="text-secondary-custom">

                                <i class="fa-solid fa-user-secret me-1"></i>

                                Anonymous

                            </span>


                        <% } else if (item.userId) { %>


                            <strong>

                                <%= item.userId.name || "User" %>

                            </strong>


                            <% if (item.userId.mobile) { %>

                                <br>

                                <small class="text-secondary-custom">

                                    <%= item.userId.mobile %>

                                </small>

                            <% } %>


                        <% } else { %>

                            <span class="text-secondary-custom">

                                Guest

                            </span>

                        <% } %>


                    </td>


                    <td>

                        <small>

                            <%= item.paymentId || "-" %>

                        </small>

                    </td>


                    <td>

                        <strong>

                            ₹<%= donationAmount.toLocaleString("en-IN", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %>

                        </strong>

                    </td>


                    <td>

                        <span class="text-success">

                            ₹<%= paidAmount.toLocaleString("en-IN", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %>

                        </span>

                    </td>


                    <td>

                        <span class="<%= remainingAmount > 0
                            ? 'text-warning'
                            : 'text-success' %>">

                            ₹<%= remainingAmount.toLocaleString("en-IN", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %>

                        </span>

                    </td>


                    <td>


                        <% if (item.payoutStatus === "success") { %>

                            <span class="badge badge-success-custom">

                                PAID

                            </span>


                        <% } else if (item.payoutStatus === "pending") { %>

                            <span class="badge badge-pending">

                                PENDING

                            </span>


                        <% } else { %>

                            <span class="badge badge-secondary-custom">

                                UNPAID

                            </span>

                        <% } %>


                    </td>


                </tr>


            <% }) %>


        <% } else { %>


            <tr>

                <td colspan="8">

                    <div class="empty-box">

                        <i class="fa-solid fa-hand-holding-heart"></i>

                        <h4>

                            No Donation History Found

                        </h4>

                        <div class="text-secondary-custom">

                            No successful donation is available for this masjid.

                        </div>

                    </div>

                </td>

            </tr>


        <% } %>


        </tbody>

    </table>

</div>


</div>

<!-- =====================================================
     PAGINATION
===================================================== -->

<% if (totalPages > 1) { %>

<div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">


<div class="text-secondary-custom">

    Page <%= currentPage %> of <%= totalPages %>

</div>


<ul class="pagination mb-0">


    <% if (currentPage > 1) { %>

        <li class="page-item">

            <a
                class="page-link"
                href="/admin/masjids/<%= masjid._id %>/payout?page=<%= currentPage - 1 %>"
            >

                Previous

            </a>

        </li>

    <% } %>



    <%
        const startPage =
            Math.max(1, currentPage - 2);

        const endPage =
            Math.min(totalPages, currentPage + 2);
    %>



    <% if (startPage > 1) { %>

        <li class="page-item">

            <a
                class="page-link"
                href="/admin/masjids/<%= masjid._id %>/payout?page=1"
            >

                1

            </a>

        </li>


        <% if (startPage > 2) { %>

            <li class="page-item disabled">

                <span class="page-link">

                    ...

                </span>

            </li>

        <% } %>

    <% } %>



    <% for (
        let i = startPage;
        i <= endPage;
        i++
    ) { %>


        <li
            class="page-item <%= currentPage === i ? 'active' : '' %>"
        >

            <a
                class="page-link"
                href="/admin/masjids/<%= masjid._id %>/payout?page=<%= i %>"
            >

                <%= i %>

            </a>

        </li>


    <% } %>



    <% if (endPage < totalPages) { %>


        <% if (endPage < totalPages - 1) { %>

            <li class="page-item disabled">

                <span class="page-link">

                    ...

                </span>

            </li>

        <% } %>


        <li class="page-item">

            <a
                class="page-link"
                href="/admin/masjids/<%= masjid._id %>/payout?page=<%= totalPages %>"
            >

                <%= totalPages %>

            </a>

        </li>


    <% } %>



    <% if (currentPage < totalPages) { %>

        <li class="page-item">

            <a
                class="page-link"
                href="/admin/masjids/<%= masjid._id %>/payout?page=<%= currentPage + 1 %>"
            >

                Next

            </a>

        </li>

    <% } %>


</ul>


</div>

<% } %>

</div>

<!-- =====================================================
     PAYOUT SETTINGS MODAL
===================================================== -->

<div
    class="modal fade"
    id="payoutSettingsModal"
    tabindex="-1"
    aria-hidden="true"
>


<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">


        <form
            method="POST"
            action="/admin/masjids/<%= masjid._id %>/payout-settings"
            id="payoutSettingsForm"
        >


            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fa-solid fa-sliders me-2"></i>

                    Payout Settings

                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">


                <div id="settingsAlert"></div>


                <div class="mb-3">

                    <label class="form-label">

                        Payout Type

                    </label>


                    <select
                        name="walletAccepted"
                        id="walletAccepted"
                        class="form-select"
                        required
                    >

                        <option
                            value="fixed"
                            <%= masjid.walletAccepted === "fixed"
                                ? "selected"
                                : "" %>
                        >

                            Fixed Amount

                        </option>


                        <option
                            value="percentage"
                            <%= masjid.walletAccepted === "percentage"
                                ? "selected"
                                : "" %>
                        >

                            Percentage

                        </option>

                    </select>

                </div>



                <div class="mb-3">

                    <label
                        class="form-label"
                        id="amountLabel"
                    >

                        Accepted Amount

                    </label>


                    <div class="input-group">

                        <span
                            class="input-group-text"
                            id="amountPrefix"
                        >
                            ₹
                        </span>


                        <input
                            type="number"
                            name="walletAcceptedAmount"
                            id="walletAcceptedAmount"
                            class="form-control"
                            value="<%= Number(masjid.walletAcceptedAmount || 0) %>"
                            min="0"
                            step="0.01"
                            required
                        >


                        <span
                            class="input-group-text"
                            id="amountSuffix"
                        >

                            INR

                        </span>

                    </div>


                    <small
                        class="text-secondary-custom"
                        id="amountHelp"
                    >

                        Enter the fixed payout amount.

                    </small>

                </div>



                <div class="info-box">

                    <i class="fa-solid fa-circle-info me-1"></i>

                    This setting determines whether the accepted payout
                    value is fixed or percentage based.

                </div>


            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >

                    Cancel

                </button>


                <button
                    type="submit"
                    class="btn btn-primary"
                    id="saveSettingsBtn"
                >

                    <i class="fa-solid fa-save me-1"></i>

                    Save Settings

                </button>

            </div>


        </form>

    </div>

</div>


</div>

<!-- =====================================================
     PAYOUT MODAL
===================================================== -->

<div
    class="modal fade"
    id="payoutModal"
    tabindex="-1"
    aria-hidden="true"
>


<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">


        <form
            method="POST"
            action="/admin/masjids/<%= masjid._id %>/payout"
            id="payoutForm"
        >


            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fa-solid fa-money-bill-transfer me-2"></i>

                    New Payout

                </h5>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>



            <div class="modal-body">


                <div id="payoutAlert"></div>


                <div class="wallet-box mb-4">

                    <div class="wallet-label">

                        Available Wallet

                    </div>

                    <div class="wallet-amount text-success">

                        ₹<%= Number(masjid.wallet || 0).toLocaleString("en-IN", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) %>

                    </div>

                </div>



                <div class="mb-3">

                    <label class="form-label">

                        Payout Amount

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">

                            ₹

                        </span>


                        <input
                            type="number"
                            name="amount"
                            id="payoutAmount"
                            class="form-control"
                            min="0.01"
                            max="<%= Number(masjid.wallet || 0) %>"
                            step="0.01"
                            placeholder="Enter payout amount"
                            required
                        >

                    </div>


                    <small class="text-secondary-custom">

                        Maximum:

                        ₹<%= Number(masjid.wallet || 0).toLocaleString("en-IN", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) %>

                    </small>

                </div>



                <div class="mb-3">

                    <label class="form-label">

                        Note

                    </label>


                    <textarea
                        name="note"
                        class="form-control"
                        rows="3"
                        maxlength="500"
                        placeholder="Enter payout note..."
                    ></textarea>

                </div>



                <div class="warning-box">

                    <i class="fa-solid fa-triangle-exclamation me-1"></i>

                    Please verify the payout amount before submitting.

                </div>


            </div>



            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >

                    Cancel

                </button>


                <button
                    type="submit"
                    class="btn btn-primary"
                    id="submitPayoutBtn"
                >

                    <i class="fa-solid fa-paper-plane me-1"></i>

                    Submit Payout

                </button>

            </div>


        </form>

    </div>

</div>


</div>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

<script>

/* =====================================================
   PAYOUT SETTING UI
===================================================== */

const walletAccepted =
    document.getElementById("walletAccepted");

const walletAcceptedAmount =
    document.getElementById("walletAcceptedAmount");

const amountPrefix =
    document.getElementById("amountPrefix");

const amountSuffix =
    document.getElementById("amountSuffix");

const amountLabel =
    document.getElementById("amountLabel");

const amountHelp =
    document.getElementById("amountHelp");


function updatePayoutSettingUI() {

    if (!walletAccepted) {
        return;
    }

    const type =
        walletAccepted.value;


    if (type === "percentage") {

        amountPrefix.textContent = "%";

        amountSuffix.textContent = "Percent";

        amountLabel.textContent =
            "Accepted Percentage";

        amountHelp.textContent =
            "Enter a percentage between 0 and 100.";

        walletAcceptedAmount.min = "0";

        walletAcceptedAmount.max = "100";

        walletAcceptedAmount.step = "0.01";


        if (
            parseFloat(walletAcceptedAmount.value) > 100
        ) {

            walletAcceptedAmount.value = "100";

        }

    } else {

        amountPrefix.textContent = "₹";

        amountSuffix.textContent = "INR";

        amountLabel.textContent =
            "Accepted Amount";

        amountHelp.textContent =
            "Enter the fixed payout amount.";

        walletAcceptedAmount.min = "0";

        walletAcceptedAmount.removeAttribute("max");

        walletAcceptedAmount.step = "0.01";

    }

}


if (walletAccepted) {

    walletAccepted.addEventListener(
        "change",
        updatePayoutSettingUI
    );

    updatePayoutSettingUI();

}



/* =====================================================
   SETTINGS SUBMIT
===================================================== */

const payoutSettingsForm =
    document.getElementById("payoutSettingsForm");

if (payoutSettingsForm) {

    payoutSettingsForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();

            const button =
                document.getElementById("saveSettingsBtn");

            const alertBox =
                document.getElementById("settingsAlert");

            const type =
                document.getElementById("walletAccepted").value;

            const amount =
                parseFloat(
                    document.getElementById(
                        "walletAcceptedAmount"
                    ).value
                );

            alertBox.innerHTML = "";

            if (!Number.isFinite(amount) || amount <= 0) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        Please enter a valid amount.
                    </div>
                `;

                return;
            }

            if (type === "percentage" && amount > 100) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        Percentage cannot be greater than 100.
                    </div>
                `;

                return;
            }

            const originalText = button.innerHTML;

            button.disabled = true;

            button.innerHTML = `
                <span class="spinner-border spinner-border-sm me-1"></span>
                Saving...
            `;

            try {

                const response = await fetch(
                    payoutSettingsForm.action,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },

                        body: JSON.stringify({
                            walletAccepted: type,
                            walletAcceptedAmount: amount
                        })
                    }
                );

                const data = await response.json();

                if (!response.ok || !data.success) {

                    throw new Error(
                        data.message ||
                        "Unable to save payout settings."
                    );
                }

                alertBox.innerHTML = `
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        ${data.message || "Payout settings updated successfully."}
                    </div>
                `;

                setTimeout(function () {
                    window.location.reload();
                }, 800);

            } catch (error) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-xmark me-1"></i>
                        ${error.message}
                    </div>
                `;

                button.disabled = false;

                button.innerHTML = originalText;
            }

        }
    );

}

/* =====================================================
   PAYOUT SUBMIT
===================================================== */

const payoutForm =
    document.getElementById("payoutForm");


if (payoutForm) {

    payoutForm.addEventListener(
        "submit",
        async function(event) {

            event.preventDefault();


            const button =
                document.getElementById("submitPayoutBtn");

            const alertBox =
                document.getElementById("payoutAlert");

            const amountInput =
                document.getElementById("payoutAmount");


            const amount =
                parseFloat(amountInput.value);


            alertBox.innerHTML = "";


            if (
                !Number.isFinite(amount) ||
                amount <= 0
            ) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        Please enter a valid payout amount.
                    </div>
                `;

                return;

            }


            const maxAmount =
                parseFloat(amountInput.max);


            if (
                Number.isFinite(maxAmount) &&
                amount > maxAmount
            ) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        Payout amount cannot exceed wallet balance.
                    </div>
                `;

                return;

            }


            const confirmed =
                confirm(
                    "Are you sure you want to process ₹" +
                    amount.toFixed(2) +
                    " payout?"
                );


            if (!confirmed) {
                return;
            }


            const originalText =
                button.innerHTML;


            button.disabled = true;

            button.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';


            try {

                const formData =
                    new FormData(
                        payoutForm
                    );


                const response =
                    await fetch(
                        payoutForm.action,
                        {
                            method: "POST",
                            body: formData,
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    );


                const data =
                    await response.json();


                if (
                    !response.ok ||
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        "Payout failed."
                    );

                }


                alertBox.innerHTML = `
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        ${data.message || "Payout processed successfully."}
                    </div>
                `;


                setTimeout(
                    () => window.location.reload(),
                    900
                );


            } catch (error) {

                alertBox.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-xmark me-1"></i>
                        ${error.message}
                    </div>
                `;


                button.disabled = false;

                button.innerHTML =
                    originalText;

            }

        }
    );

}

</script>

</body>

</html>
