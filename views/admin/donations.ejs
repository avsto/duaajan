<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Donation History - DuaAjan Admin</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>

    <style>
      body {
        margin: 0;
        background: #0f172a;
        color: #fff;
        font-family: Arial, sans-serif;
      }

      .topbar {
        background: #111827;
        padding: 20px 30px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .brand {
        font-size: 24px;
        font-weight: 700;
      }

      .page-card {
        background: #111827;
        border-radius: 24px;
        padding: 25px;
        margin-top: 30px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }

      .stats-card {
        background: #1e293b;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        margin-bottom: 25px;
      }

      .stats-card h2 {
        margin: 0;
        color: #10b981;
        font-weight: 700;
      }

      .stats-card p {
        margin: 0;
        color: #94a3b8;
      }

      .table {
        color: white;
        margin-bottom: 0;
      }

      .table thead {
        background: #1e293b;
      }

      .table th {
        border: none;
        color: #cbd5e1;
        padding: 16px;
      }

      .table td {
        border-color: rgba(255, 255, 255, 0.05);
        padding: 16px;
        vertical-align: middle;
      }

      .search-box {
        background: #1e293b;
        border: none;
        color: white;
        height: 50px;
        border-radius: 14px;
      }

      .search-box:focus {
        background: #1e293b;
        color: white;
        box-shadow: none;
      }

      .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
      }

      .amount {
        color: #10b981;
        font-weight: 700;
        font-size: 16px;
      }

      .action-btn {
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
      }

      .btn-view {
        background: #3b82f6;
        color: white;
      }

      .pagination .page-link {
        background: #1e293b;
        border-color: #334155;
        color: #fff;
      }

      .pagination .active .page-link {
        background: #3b82f6;
        border-color: #3b82f6;
      }

      .pagination .disabled .page-link {
        background: #111827;
        color: #64748b;
      }
    </style>
  </head>

  <body>
    <div id="app">
      <div class="topbar">
        <div class="d-flex justify-content-between align-items-center">
          <div class="brand">
            <i class="fa-solid fa-hand-holding-heart me-2"></i>
            Donation History
          </div>

          <a href="/admin/dashboard" class="btn btn-light"> Dashboard </a>
        </div>
      </div>

      <div class="container py-4">
        <div class="row">
          <div class="col-md-4">
            <div class="stats-card">
              <h2>₹ {{ totalAmount }}</h2>
              <p>Total Donations</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="stats-card">
              <h2>{{ totalDonations }}</h2>
              <p>Total Transactions</p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="stats-card">
              <h2>{{ successDonations }}</h2>
              <p>Successful Payments</p>
            </div>
          </div>
        </div>

        <div class="page-card">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0">Donation Records ({{ totalDonations }})</h3>

            <input
              type="text"
              class="form-control search-box"
              style="max-width: 300px"
              placeholder="Search donor..."
              v-model="search"
              @keyup.enter="searchDonations"
            />
          </div>

          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Donor</th>
                  <th>Amount</th>
                  <th>Masjid</th>
                  <th>Payment</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>
                <tr v-for="donation in donations" :key="donation._id">
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="avatar me-3">
                        {{
                          donation.userId?.name
                            ? donation.userId.name.charAt(0).toUpperCase()
                            : "U"
                        }}
                      </div>

                      <div>
                        {{
                          donation.anonymous
                            ? "Anonymous"
                            : donation.userId?.name || "Unknown"
                        }}
                      </div>
                    </div>
                  </td>

                  <td class="amount">₹ {{ donation.amount }}</td>

                  <td>
                    {{ donation.masjidId?.name || "-" }}
                  </td>

                  <td>
                    {{ donation.paymentMethod }}
                  </td>

                  <td>
                    <span
                      class="badge"
                      :class="{
'bg-success': donation.paymentStatus === 'success',
'bg-warning': donation.paymentStatus === 'pending',
'bg-danger': donation.paymentStatus === 'failed'
}"
                    >
                      {{ donation.paymentStatus }}
                    </span>
                  </td>

                  <td>
                    {{ formatDate(donation.createdAt) }}
                  </td>

                  <td>
                    <button
                      class="action-btn btn-view"
                      @click="viewDonation(donation)"
                    >
                      View
                    </button>
                  </td>
                </tr>

                <tr v-if="donations.length === 0">
                  <td colspan="7" class="text-center py-4">
                    No Donations Found
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <div>Page {{ page }} of {{ totalPages }}</div>

            <nav v-if="totalPages > 1">
              <ul class="pagination mb-0">
                <li class="page-item" :class="{ disabled: page === 1 }">
                  <a class="page-link" :href="getPageUrl(page - 1)">
                    Previous
                  </a>
                </li>

                <li
                  v-for="p in visiblePages"
                  :key="p"
                  class="page-item"
                  :class="{ active: p === page }"
                >
                  <a class="page-link" :href="getPageUrl(p)">
                    {{ p }}
                  </a>
                </li>

                <li
                  class="page-item"
                  :class="{ disabled: page === totalPages }"
                >
                  <a class="page-link" :href="getPageUrl(page + 1)"> Next </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <script>

      new Vue({

      el:"#app",

      data:{

      search:'<%= search %>',

      page:<%= page %>,

      totalPages:<%= totalPages %>,

      totalDonations:<%= totalDonations %>,

      successDonations:<%= successDonations %>,

      totalAmount:<%= totalAmount %>,

      donations:<%- JSON.stringify(donations) %>

      },

      computed:{

      visiblePages(){

      let start=Math.max(1,this.page-2);
      let end=Math.min(this.totalPages,start+4);

      if(end-start<4){
      start=Math.max(1,end-4);
      }

      let pages=[];

      for(let i=start;i<=end;i++){
      pages.push(i);
      }

      return pages;

      }

      },

      methods:{

      formatDate(date){

      return new Date(date).toLocaleDateString();

      },

      searchDonations(){

      window.location.href=
      `/admin/donations?page=1&search=${encodeURIComponent(this.search)}`;

      },

      getPageUrl(page){

      return `/admin/donations?page=${page}&search=${encodeURIComponent(this.search)}`;

      },

      viewDonation(donation){

      alert(
      "Donor : " + (donation.userId?.name || "Anonymous") +
      "\nAmount : ₹" + donation.amount +
      "\nPayment : " + donation.paymentMethod +
      "\nStatus : " + donation.paymentStatus +
      "\nMessage : " + (donation.message || "-") +
      "\nOrder ID : " + (donation.orderId || "-")
      );

      }

      }

      });
    </script>
  </body>
</html>
